function(drakengard_prepare_body_probe source_variable)
    file(SHA256 "${REPO_ROOT}/work/extracted-001/SLES_523.22" body_elf_hash)
    if(NOT body_elf_hash STREQUAL "065a94591d295bb936a8dca92e722c3bd72cd05848c7274b26d572b0f782e918")
        message(FATAL_ERROR "Body observations require verified Europe ELF")
    endif()
    configure_file("${REPO_ROOT}/native/runner/ee_body_probe.h"
        "${CMAKE_BINARY_DIR}/private_headers/ee_body_probe.h" COPYONLY)
    configure_file("${REPO_ROOT}/native/runner/ee_geometry_probe.h"
        "${CMAKE_BINARY_DIR}/private_headers/ee_geometry_probe.h" COPYONLY)
    configure_file("${REPO_ROOT}/native/runner/caim_vif_trace.h"
        "${CMAKE_BINARY_DIR}/private_headers/caim_vif_trace.h" COPYONLY)
    set(prepared)
    set(matches 0)
    set(geometry_matches 0)
    foreach(source IN LISTS ${source_variable})
        get_filename_component(name "${source}" NAME)
        if(name STREQUAL "fn_0019DD4C_0x19dd4c.cpp")
            file(READ "${source}" text)
            foreach(boundary IN ITEMS 19dda8 19de48 19de5c)
                set(anchor "label_${boundary}:\n    // 0x${boundary}:")
                string(FIND "${text}" "${anchor}" position)
                if(position LESS 0)
                    message(FATAL_ERROR "Body return/resume anchor changed: ${boundary}")
                endif()
                math(EXPR next "${position}+1")
                string(SUBSTRING "${text}" ${next} -1 remainder)
                string(FIND "${remainder}" "${anchor}" duplicate)
                if(NOT duplicate LESS 0)
                    message(FATAL_ERROR "Duplicated body return/resume anchor: ${boundary}")
                endif()
                string(REPLACE "${anchor}"
                    "label_${boundary}:\n    drakengard::observeEeBodyProbe(rdram,{0x${boundary}u,ctx->pc,GPR_U32(ctx,17),GPR_U32(ctx,29),GPR_U32(ctx,2),GPR_U32(ctx,19)});\n    // 0x${boundary}:"
                    text "${text}")
            endforeach()
            set(path "${CMAKE_BINARY_DIR}/guest_body/${name}")
            file(CONFIGURE OUTPUT "${path}" CONTENT "#include \"ee_body_probe.h\"\n${text}" @ONLY)
            list(APPEND prepared "${path}")
            math(EXPR matches "${matches}+1")
        elseif(name STREQUAL "fn_0029DC28_0x29dc28.cpp")
            file(READ "${source}" text)
            foreach(boundary IN ITEMS 29e1a0 29e21c)
                set(anchor "label_${boundary}:\n    // 0x${boundary}:")
                string(FIND "${text}" "${anchor}" position)
                if(position LESS 0)
                    message(FATAL_ERROR "Geometry return/resume anchor changed: ${boundary}")
                endif()
                math(EXPR next "${position}+1")
                string(SUBSTRING "${text}" ${next} -1 remainder)
                string(FIND "${remainder}" "${anchor}" duplicate)
                if(NOT duplicate LESS 0)
                    message(FATAL_ERROR "Duplicated geometry return/resume anchor: ${boundary}")
                endif()
                string(REPLACE "${anchor}"
                    "label_${boundary}:\n    drakengard::observeEeGeometryProbe(rdram,{0x${boundary}u,ctx->pc,GPR_U32(ctx,29),GPR_U32(ctx,17),GPR_U32(ctx,22),GPR_U32(ctx,20)});\n    // 0x${boundary}:"
                    text "${text}")
            endforeach()
            set(path "${CMAKE_BINARY_DIR}/guest_body/${name}")
            file(CONFIGURE OUTPUT "${path}" CONTENT "#include \"ee_geometry_probe.h\"\n${text}" @ONLY)
            list(APPEND prepared "${path}")
            math(EXPR geometry_matches "${geometry_matches}+1")
        else()
            list(APPEND prepared "${source}")
        endif()
    endforeach()
    if(NOT matches EQUAL 1 OR NOT geometry_matches EQUAL 1)
        message(FATAL_ERROR "Body observations need exactly two verified compiler units")
    endif()
    set(${source_variable} "${prepared}" PARENT_SCOPE)
endfunction()
