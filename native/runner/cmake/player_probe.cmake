# Original opt-in observation in build-local compiler units; inputs stay read-only.
function(drakengard_prepare_player_probe source_variable)
    file(SHA256 "${REPO_ROOT}/work/extracted-001/SLES_523.22" player_elf_hash)
    if(NOT player_elf_hash STREQUAL "065a94591d295bb936a8dca92e722c3bd72cd05848c7274b26d572b0f782e918")
        message(FATAL_ERROR "Player entry observations require verified Europe ELF")
    endif()
    configure_file("${REPO_ROOT}/native/runner/ee_player_probe.h"
        "${CMAKE_BINARY_DIR}/private_headers/ee_player_probe.h" COPYONLY)
    set(prepared)
    set(matches 0)
    foreach(source IN LISTS ${source_variable})
        get_filename_component(name "${source}" NAME)
        if(name MATCHES "^fn_00(1274C8|1776F4|179758|19F068)_")
            string(TOLOWER "${CMAKE_MATCH_1}" entry)
            file(READ "${source}" text)
            set(anchor "    ctx->pc = 0x${entry}u;\n\n    // 0x${entry}:")
            string(FIND "${text}" "${anchor}" position)
            if(position LESS 0)
                message(FATAL_ERROR "Pinned player entry/prologue changed: ${name}")
            endif()
            math(EXPR after_anchor "${position}+1")
            string(SUBSTRING "${text}" ${after_anchor} -1 remainder)
            string(FIND "${remainder}" "${anchor}" duplicate)
            if(NOT duplicate LESS 0)
                message(FATAL_ERROR "Duplicated player entry/prologue: ${name}")
            endif()
            string(REPLACE "${anchor}"
                "    ctx->pc = 0x${entry}u;\n    drakengard::observeEePlayerProbe(rdram,ctx,0x${entry}u);\n\n    // 0x${entry}:"
                observed "${text}")
            set(path "${CMAKE_BINARY_DIR}/guest_player/${name}")
            file(CONFIGURE OUTPUT "${path}" CONTENT "#include \"ee_player_probe.h\"\n${observed}" @ONLY)
            list(APPEND prepared "${path}")
            math(EXPR matches "${matches}+1")
        else()
            list(APPEND prepared "${source}")
        endif()
    endforeach()
    if(NOT matches EQUAL 4)
        message(FATAL_ERROR "Player observation needs exactly four verified compiler units")
    endif()
    include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/control_probe.cmake")
    drakengard_prepare_control_probe(prepared)
    set(${source_variable} "${prepared}" PARENT_SCOPE)
endfunction()
