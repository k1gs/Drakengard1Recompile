# Correct the pinned emitter's 32-bit signed branch tests without editing lifts
# or upstream. All branch families compare the signed low 64-bit EE register.
function(drakengard_correct_signed_branches source_variable output_directory)
    file(MAKE_DIRECTORY "${output_directory}")
    set(prepared_sources)
    set(corrected_count 0)
    foreach(source IN LISTS ${source_variable})
        file(READ "${source}" original)
        string(REGEX REPLACE
            "const bool (branch_taken_0x[0-9a-fA-F]+) = \\(GPR_S32\\(ctx, ([0-9]+)\\) ([<>]=?) 0\\);"
            "const bool \\1 = (GPR_S64(ctx, \\2) \\3 0);"
            corrected "${original}")
        if(corrected MATCHES "const bool branch_taken_[^\n]*GPR_S32")
            message(FATAL_ERROR "Unreviewed signed branch emission in ${source}")
        endif()
        if(corrected STREQUAL original)
            list(APPEND prepared_sources "${source}")
            continue()
        endif()
        get_filename_component(name "${source}" NAME)
        set(destination "${output_directory}/${name}")
        set(previous "")
        if(EXISTS "${destination}")
            file(READ "${destination}" previous)
        endif()
        if(NOT previous STREQUAL corrected)
            file(WRITE "${destination}" "${corrected}")
        endif()
        list(APPEND prepared_sources "${destination}")
        math(EXPR corrected_count "${corrected_count}+1")
    endforeach()
    message(STATUS "Prepared ${corrected_count} units with 64-bit signed EE branches")
    set(${source_variable} "${prepared_sources}" PARENT_SCOPE)
endfunction()
