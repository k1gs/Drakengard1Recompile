# Preserve the immutable vector zero register at the shared writeback boundary.
# FMAC normalization and flags happen before applyDest and remain untouched.
function(drakengard_prepare_micro_vf0 upstream_root output)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${upstream_root}/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp")
    file(READ "${upstream_root}/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp" source)
    string(FIND "${source}" "void VU1Interpreter::applyDest(" begin)
    string(FIND "${source}" "void VU1Interpreter::applyDestAcc(" end)
    if(begin LESS 0 OR end LESS begin)
        message(FATAL_ERROR "Pinned micro VU writeback boundaries changed")
    endif()
    math(EXPR length "${end}-${begin}")
    string(SUBSTRING "${source}" ${begin} ${length} body)
    string(SHA256 digest "${body}")
    if(NOT digest STREQUAL "91ab01e16a37608b4ae003d2559e270f67febce30d63ae5b72b9f052f77f1abb")
        message(FATAL_ERROR "Unreviewed micro VU destination writeback body")
    endif()
    set(anchor "void VU1Interpreter::applyDest(float *dst, const float *result, uint8_t dest)\n{")
    string(REPLACE "${anchor}" "${anchor}\n    if (dst == m_state.vf[0]) {\n        drakengard::observeMicroVf0Discard(m_state.pc,dest,result,[this](uint32_t lower) { return vfReadLanes(decodeLowerUsage(lower),0u); });\n        return;\n    }" prepared "${source}")
    if(prepared STREQUAL source)
        message(FATAL_ERROR "Pinned micro VU destination writeback changed")
    endif()
    set(anchor "    m_activeVuData = vuData;")
    string(REPLACE "${anchor}" "    drakengard::MicroVf0RunScope vf0Scope(static_cast<unsigned>(m_unit),vuCode,codeSize);\n${anchor}" next "${prepared}")
    if(next STREQUAL prepared)
        message(FATAL_ERROR "Pinned micro VU run entry changed")
    endif()
    set(prepared "${next}")
    set(anchor "execLower(decoded.lower, vuData, dataSize, gs, memory, decoded.upper);")
    string(REGEX MATCHALL "execLower\\(decoded[.]lower, vuData, dataSize, gs, memory, decoded[.]upper\\)" calls "${prepared}")
    list(LENGTH calls count)
    if(NOT count EQUAL 2)
        message(FATAL_ERROR "Pinned micro VU lower dispatch changed")
    endif()
    string(REPLACE "${anchor}" "{ drakengard::MicroVf0LowerScope vf0Phase; ${anchor} }" prepared "${prepared}")
    set(anchor "    if (m_activeMemory)\n        m_activeMemory->submitGifPacket(GifPathId::Path1, m_xgkick.packet.data(), m_xgkick.totalBytes);")
    string(REPLACE "${anchor}"
        "    drakengard::GsKickOfferScope kickOrigin(m_xgkick.packet.data(),m_xgkick.totalBytes,{true,m_state.pc,m_xgkick.sourceAddress,m_xgkick.totalBytes,m_xgkick.issueCycle,m_cycle});\n${anchor}"
        next "${prepared}")
    if(next STREQUAL prepared)
        message(FATAL_ERROR "Pinned XGKICK submit boundary changed")
    endif()
    file(CONFIGURE OUTPUT "${output}" CONTENT "#include \"vu_micro_vf0.h\"\n#include \"gs_path1_capture.h\"\n${next}" @ONLY)
endfunction()
