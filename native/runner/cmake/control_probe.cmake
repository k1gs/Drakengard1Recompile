include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/pinned_patch.cmake")
function(drakengard_control_replace variable anchor replacement contract)
    string(FIND "${${variable}}" "${anchor}" first)
    if(first LESS 0)
        message(FATAL_ERROR "Missing control anchor: ${contract}")
    endif()
    math(EXPR next "${first}+1")
    string(SUBSTRING "${${variable}}" ${next} -1 remainder)
    string(FIND "${remainder}" "${anchor}" duplicate)
    if(NOT duplicate LESS 0)
        message(FATAL_ERROR "Duplicated control anchor: ${contract}")
    endif()
    string(REPLACE "${anchor}" "${replacement}" text "${${variable}}")
    set(${variable} "${text}" PARENT_SCOPE)
endfunction()
function(drakengard_prepare_control_probe source_variable)
    file(SHA256 "${REPO_ROOT}/work/extracted-001/SLES_523.22" digest)
    if(NOT digest STREQUAL "065a94591d295bb936a8dca92e722c3bd72cd05848c7274b26d572b0f782e918")
        message(FATAL_ERROR "Control observations require verified Europe ELF")
    endif()
    configure_file("${REPO_ROOT}/native/runner/ee_control_probe.h" "${CMAKE_BINARY_DIR}/private_headers/ee_control_probe.h" COPYONLY)
    set(control_prepared)
    set(matches 0)
    foreach(source IN LISTS ${source_variable})
        get_filename_component(name "${source}" NAME)
        if(name MATCHES "^fn_00(1441E4|1408A0|144884|19A808|19B2B4|14C350|143698|143598|143610|14CAF0)_")
            set(entry "${CMAKE_MATCH_1}")
            string(TOLOWER "${entry}" lower)
            file(READ "${source}" text)
            set(call "drakengard::eeControlProbe.observe(rdram,{POINT,ctx->pc,GPR_U32(ctx,4),GPR_U32(ctx,5),GPR_U32(ctx,2),GPR_U32(ctx,31),GPR_U32(ctx,29)},std::getenv(\"DRAKENGARD_EE_CONTROL_TRACE\"));")
            string(REPLACE "POINT" "0x${lower}u" hook "${call}")
            if(entry STREQUAL "1408A0" OR entry STREQUAL "19A808")
                drakengard_control_replace(text "label_${lower}:" "label_${lower}:\n    ${hook}" "Control labeled entry ${entry}")
            else()
                set(anchor "    ctx->pc = 0x${lower}u;\n\n    // 0x${lower}:")
                drakengard_control_replace(text "${anchor}" "    ctx->pc = 0x${lower}u;\n    ${hook}\n\n    // 0x${lower}:" "Control entry ${entry}")
            endif()
            set(labels)
            if(entry STREQUAL "1441E4")
                set(labels 14421c)
            elseif(entry STREQUAL "1408A0")
                set(labels 140924)
            elseif(entry STREQUAL "144884")
                set(labels 1448c8 1448dc 1448ec)
            elseif(entry STREQUAL "14C350")
                set(labels 14c39c 14c3ac 14c3d4)
            elseif(entry STREQUAL "143598")
                set(labels 143600)
            elseif(entry STREQUAL "143610")
                set(labels 143634 14365c)
            elseif(entry STREQUAL "14CAF0")
                set(labels 14cb54)
            endif()
            foreach(label IN LISTS labels)
                string(REPLACE "POINT" "0x${label}u" hook "${call}")
                drakengard_control_replace(text "label_${label}:" "label_${label}:\n    ${hook}" "Control resume ${label}")
            endforeach()
            set(output "${CMAKE_BINARY_DIR}/guest_control/${name}")
            file(CONFIGURE OUTPUT "${output}" CONTENT "#include <cstdlib>\n#include \"ee_control_probe.h\"\n${text}" @ONLY)
            list(APPEND control_prepared "${output}")
            math(EXPR matches "${matches}+1")
        else()
            list(APPEND control_prepared "${source}")
        endif()
    endforeach()
    if(NOT matches EQUAL 10)
        message(FATAL_ERROR "Control observation needs exactly ten compiler units")
    endif()
    set(${source_variable} "${control_prepared}" PARENT_SCOPE)
endfunction()
